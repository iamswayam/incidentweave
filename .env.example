APP_ENV=development
DATABASE_URL=postgresql://incidentweave:incidentweave@localhost:5432/incidentweave
GEMINI_API_KEY=
API_PROTECTION_SECRET=
PROVIDER_USAGE_LOG_ENABLED=false
PROVIDER_USAGE_LOG_TIMEOUT_SECONDS=2

# Optional provider pacing and cooldown settings; unset = disabled.
PROVIDER_RATE_LIMIT_RPM=
PROVIDER_RATE_LIMIT_TPM=
PROVIDER_RATE_LIMIT_RPD=
PROVIDER_COOLDOWN_FAILURES=
PROVIDER_COOLDOWN_SECONDS=

# Optional generation-only Groq fallback; disabled unless explicitly enabled.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_ENABLED=false
GROQ_TIMEOUT_SECONDS=60
GROQ_RATE_LIMIT_RPM=
GROQ_RATE_LIMIT_TPM=
GROQ_RATE_LIMIT_RPD=
GROQ_COOLDOWN_FAILURES=
GROQ_COOLDOWN_SECONDS=
