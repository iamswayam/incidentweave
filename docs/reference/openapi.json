{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InvestigationEvidence": {
        "description": "Content-free location and ranking metadata for retrieved evidence.",
        "properties": {
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "end_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Line"
          },
          "file_path": {
            "title": "File Path",
            "type": "string"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "rrf_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rrf Score"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Line"
          },
          "vector_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vector Score"
          }
        },
        "required": [
          "chunk_id",
          "file_path",
          "start_line",
          "end_line",
          "rank",
          "rrf_score",
          "vector_score"
        ],
        "title": "InvestigationEvidence",
        "type": "object"
      },
      "InvestigationRequest": {
        "description": "Input for one synchronous grounded investigation.",
        "properties": {
          "limit": {
            "default": 5,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "repository_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Repository Name",
            "type": "string"
          }
        },
        "required": [
          "repository_name",
          "query"
        ],
        "title": "InvestigationRequest",
        "type": "object"
      },
      "InvestigationResponse": {
        "description": "Investigation output with the model's self-rating and its limitations.",
        "properties": {
          "citation_validation": {
            "additionalProperties": true,
            "title": "Citation Validation",
            "type": "object"
          },
          "cited_chunk_ids": {
            "items": {
              "type": "string"
            },
            "title": "Cited Chunk Ids",
            "type": "array"
          },
          "claims": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Claims",
            "type": "array"
          },
          "degraded": {
            "default": false,
            "title": "Degraded",
            "type": "boolean"
          },
          "degraded_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Degraded Reason"
          },
          "diagnosis": {
            "title": "Diagnosis",
            "type": "string"
          },
          "evaluation_note": {
            "title": "Evaluation Note",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/InvestigationEvidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "evidence_check": {
            "additionalProperties": true,
            "title": "Evidence Check",
            "type": "object"
          },
          "investigation_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Investigation Id"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "model_self_rating": {
            "title": "Model Self Rating",
            "type": "string"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "rating_note": {
            "title": "Rating Note",
            "type": "string"
          },
          "repository_name": {
            "title": "Repository Name",
            "type": "string"
          },
          "retry_used": {
            "title": "Retry Used",
            "type": "boolean"
          },
          "tool_calls": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Tool Calls",
            "type": "array"
          },
          "unavailable_answer": {
            "default": false,
            "title": "Unavailable Answer",
            "type": "boolean"
          },
          "uncertainty_note": {
            "default": "",
            "title": "Uncertainty Note",
            "type": "string"
          }
        },
        "required": [
          "investigation_id",
          "repository_name",
          "query",
          "diagnosis",
          "outcome",
          "model_self_rating",
          "rating_note",
          "cited_chunk_ids",
          "evidence_check",
          "retry_used",
          "tool_calls",
          "model",
          "latency_ms",
          "evaluation_note"
        ],
        "title": "InvestigationResponse",
        "type": "object"
      },
      "RepositorySummary": {
        "description": "Read-only repository chunk and embedding counts.",
        "properties": {
          "chunk_count": {
            "title": "Chunk Count",
            "type": "integer"
          },
          "embedded_chunk_count": {
            "title": "Embedded Chunk Count",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "chunk_count",
          "embedded_chunk_count"
        ],
        "title": "RepositorySummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "IncidentWeave",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Return a minimal application health response.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/investigations": {
      "post": {
        "description": "Run and persist one investigation synchronously.",
        "operationId": "create_investigation_investigations_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Secret",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Secret"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvestigationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvestigationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Investigation"
      }
    },
    "/investigations/{investigation_id}": {
      "get": {
        "description": "Fetch a persisted investigation and its audit trace.",
        "operationId": "get_investigation_investigations__investigation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "investigation_id",
            "required": true,
            "schema": {
              "title": "Investigation Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-API-Secret",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Secret"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvestigationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Investigation"
      }
    },
    "/repositories": {
      "get": {
        "description": "List repositories and their total/embedded chunk counts.",
        "operationId": "list_repositories_repositories_get",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Secret",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Secret"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RepositorySummary"
                  },
                  "title": "Response List Repositories Repositories Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Repositories"
      }
    }
  }
}
